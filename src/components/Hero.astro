---
import { whatsappLink, SHOWREEL_VIMEO_ID } from '../data/site';
const reelSrc = SHOWREEL_VIMEO_ID
  ? `https://player.vimeo.com/video/${SHOWREEL_VIMEO_ID}?background=1&autoplay=1&loop=1&muted=1`
  : '';
---
<section id="topo" class="hero">
  <div class="halo glow" aria-hidden="true"></div>

  <div class="wrap head">
    <div class="pill up">
      <span class="dot"></span>Produtora audiovisual em Ijuí, RS
    </div>
    <h1 class="h-xl up d1">Sua marca,<br />em movimento.</h1>
    <p class="lead up d2">
      Vídeos com olhar de cinema para empresas, marcas e criadores. Roteiro, direção e acabamento — do primeiro quadro ao último corte.
    </p>
    <div class="ctas up d3">
      <a class="btn btn-lime" href={whatsappLink} target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 21l2.3-5.3A8.4 8.4 0 1 1 21 11.5z"/></svg>
        Falar no WhatsApp
      </a>
      <a class="btn btn-ghost" href="#trabalhos">Ver trabalhos →</a>
    </div>
  </div>

  <!-- Janela de editor (estilo Linear) + play 3D (estilo Raycast) -->
  <div class="stage up d4">
    <div class="play3d" aria-hidden="true">
      <svg width="58" height="58" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="#0a0a0a"/></svg>
    </div>

    <div class="editor">
      <div class="bar">
        <span></span><span></span><span></span>
        <em class="mono">showreel_machadofilms_2026.mov</em>
      </div>

      <div class="viewer">
        {reelSrc ? (
          <iframe src={reelSrc} title="Showreel Machado Films" allow="autoplay; fullscreen; picture-in-picture" loading="lazy"></iframe>
        ) : (
          <div class="empty">
            <div class="ring"><svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="#ededed"/></svg></div>
            <span>Seu showreel entra aqui</span>
          </div>
        )}
        <div class="hud tl mono"><span class="recdot"></span>REC</div>
        <div class="hud tr mono">4K · 24 fps</div>
        <div class="hud br mono" data-tc>00:00:12:04</div>
      </div>

      <div class="timeline" aria-hidden="true">
        <div class="head-line"></div>
        <div class="track">
          <i class="c-lime" style="flex:3"></i>
          <i class="c-blue" style="flex:2"></i>
          <i class="c-lime" style="flex:4"></i>
          <i class="c-violet" style="flex:2"></i>
        </div>
        <div class="wave"></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Timecode rodando no canto do editor
  const tc = document.querySelector<HTMLElement>('[data-tc]');
  if (tc && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let f = 12 * 24 + 4;
    const pad = (n: number) => String(n).padStart(2, '0');
    setInterval(() => {
      f = (f + 1) % (60 * 60 * 24);
      const s = Math.floor(f / 24), fr = f % 24;
      tc.textContent = `00:${pad(Math.floor(s / 60))}:${pad(s % 60)}:${pad(fr)}`;
    }, 1000 / 24);
  }
</script>

<style>
  .hero {
    position: relative;
    padding: 110px 0 120px;
    overflow-x: clip;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 72px 72px;
    background-position: center top;
    mask-image: linear-gradient(180deg, #000 55%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent);
  }
  .halo {
    position: absolute; left: 50%; top: 260px; width: min(900px, 120vw); height: 520px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(162,202,68,.22), transparent);
    pointer-events: none;
  }
  .head { position: relative; text-align: center; max-width: 1000px; }
  .pill {
    display: inline-flex; align-items: center; gap: 10px;
    border: 1px solid var(--line-2); background: rgba(255,255,255,.03);
    border-radius: 999px; padding: 7px 14px; font-size: 13px; color: var(--mut);
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 10px var(--lime); }
  h1 { margin-top: 28px; }
  .lead { margin: 28px auto 0; max-width: 600px; }
  .ctas { margin-top: 40px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  .stage { position: relative; max-width: 1080px; margin: 80px auto 0; padding: 0 24px; }
  .play3d {
    position: absolute; right: -16px; top: -70px; z-index: 3;
    width: 150px; height: 150px; border-radius: 38px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(145deg, #cde97a 0%, #a2ca44 42%, #5c7a17 100%);
    box-shadow: inset 0 2px 0 rgba(255,255,255,.55), inset 0 -10px 24px rgba(0,0,0,.35),
      0 40px 80px rgba(162,202,68,.35), 0 10px 30px rgba(0,0,0,.6);
    animation: float 7s ease-in-out infinite;
  }
  .editor {
    border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: var(--panel);
    box-shadow: 0 50px 120px rgba(0,0,0,.8); overflow: hidden;
  }
  .bar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--line); }
  .bar span { width: 11px; height: 11px; border-radius: 50%; background: #2a2a2a; }
  .bar em { margin-left: 12px; font-style: normal; font-size: 12px; color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .viewer { position: relative; aspect-ratio: 16 / 8; background: radial-gradient(120% 90% at 30% 20%, #1d2612 0%, #0d0f0a 45%, #050505 100%); }
  .viewer iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .empty { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; color: #6f6f6f; font-size: 14px; }
  .ring { width: 76px; height: 76px; border-radius: 50%; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.04); display: flex; align-items: center; justify-content: center; }
  .hud { position: absolute; font-size: 12px; display: flex; align-items: center; gap: 8px; }
  .tl { left: 20px; top: 16px; color: var(--ink); }
  .tr { left: 20px; bottom: 16px; color: var(--mut); }
  .br { right: 20px; bottom: 16px; color: var(--lime); font-variant-numeric: tabular-nums; }
  .recdot { width: 8px; height: 8px; border-radius: 50%; background: #ff4d4d; animation: rec 1.4s steps(1) infinite; }

  .timeline { position: relative; padding: 16px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; }
  .head-line { position: absolute; top: 8px; bottom: 8px; width: 2px; background: var(--lime); box-shadow: 0 0 12px var(--lime); z-index: 2; animation: playhead 9s linear infinite; }
  .track { display: flex; gap: 6px; height: 30px; }
  .track i { border-radius: 6px; }
  .c-lime { background: linear-gradient(90deg, #2b3a14, #3d5219); border: 1px solid rgba(162,202,68,.35); }
  .c-blue { background: linear-gradient(90deg, #1c2530, #24313f); border: 1px solid var(--line); }
  .c-violet { background: linear-gradient(90deg, #2a1f2e, #352838); border: 1px solid var(--line); }
  .wave {
    height: 22px; border-radius: 6px; opacity: .45;
    background: repeating-linear-gradient(90deg, rgba(162,202,68,.5) 0 2px, transparent 2px 5px);
    mask-image: linear-gradient(180deg, transparent 0, #000 30%, #000 70%, transparent);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 30%, #000 70%, transparent);
  }

  @media (max-width: 760px) {
    .hero { padding: 72px 0 80px; }
    .hero::before { background-size: 48px 48px; }
    .ctas .btn { width: 100%; }
    .stage { margin-top: 56px; padding: 0 16px; }
    .play3d { width: 84px; height: 84px; border-radius: 22px; right: 4px; top: -40px; }
    .play3d svg { width: 32px; height: 32px; }
    .viewer { aspect-ratio: 16 / 10; }
    .tr { display: none; }
  }
</style>
