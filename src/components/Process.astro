---
import { steps } from '../data/site';
---
<section id="processo" class="sec process">
  <div class="wrap">
    <div class="head rv">
      <h2 class="h-lg">Do briefing<br />à entrega.</h2>
      <p class="lead">Um processo claro, com você acompanhando cada etapa e aprovando os cortes antes da versão final.</p>
    </div>

    <div class="board rv">
      {steps.map((c, i) => (
        <div class="col">
          <div class="col-head">
            <span class="ring" style={`border-color:${c.color}`}></span>
            {c.name}
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <div class="card">
            <div class="code mono">{c.code}</div>
            <div class="title">{c.title}</div>
            <p>{c.text}</p>
            <span class="status"><i style={`background:${c.color}`}></i>{c.pill}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process {
    padding: 120px 0 140px;
    background: radial-gradient(60% 50% at 50% 0%, rgba(162,202,68,.08), transparent);
  }
  .head { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; align-items: end; margin-bottom: 56px; }
  .head .lead { margin: 0; }
  .board {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px;
    border: 1px solid rgba(255,255,255,.1); border-radius: 18px; background: var(--panel); padding: 16px;
    box-shadow: 0 40px 100px rgba(0,0,0,.6);
  }
  .col { display: flex; flex-direction: column; gap: 12px; }
  .col-head { display: flex; align-items: center; gap: 8px; font-size: 14px; padding: 4px 4px 8px; }
  .ring { width: 10px; height: 10px; border-radius: 50%; border: 2px solid; }
  .n { color: #6f6f6f; }
  .card {
    border: 1px solid var(--line); border-radius: 12px; background: var(--card); padding: 14px;
    transition: border-color .3s, transform .3s;
  }
  .card:hover { border-color: rgba(162,202,68,.4); transform: translateY(-2px); }
  .code { font-size: 11px; color: #6f6f6f; }
  .title { margin-top: 6px; font-size: 15px; font-weight: 600; }
  .card p { margin: 8px 0 0; font-size: 13px; line-height: 1.5; color: var(--mut); }
  .status {
    margin-top: 12px; display: inline-flex; align-items: center; gap: 6px;
    border: 1px solid rgba(255,255,255,.1); border-radius: 999px; padding: 3px 10px; font-size: 12px; color: var(--mut);
  }
  .status i { width: 6px; height: 6px; border-radius: 50%; }

  @media (max-width: 860px) {
    .process { padding: 88px 0 96px; }
    .head { grid-template-columns: minmax(0, 1fr); gap: 16px; margin-bottom: 40px; }
    .board { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .board { grid-template-columns: minmax(0, 1fr); }
  }
</style>
