---
import { clients } from '../data/site';
---
<section class="sec clients">
  <p>Marcas que já confiaram na Machado Films</p>
  <div class="wrap grid">
    {clients.map((c) => (
      <div class={c.src ? 'logo' : 'logo empty'}>
        {c.src ? <img src={c.src} alt={c.name} loading="lazy" /> : <span class="mono">Logo do cliente</span>}
      </div>
    ))}
  </div>
</section>

<style>
  .clients { padding: 80px 0; }
  p { margin: 0 0 32px; text-align: center; font-size: 14px; color: var(--dim); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; max-width: 1100px; }
  .logo { height: 72px; border-radius: 12px; display: flex; align-items: center; justify-content: center; padding: 14px; }
  .logo img { max-height: 36px; max-width: 100%; width: auto; opacity: .7; filter: grayscale(1) brightness(1.6); transition: opacity .3s, filter .3s; }
  .logo img:hover { opacity: 1; filter: none; }
  .empty { border: 1px dashed rgba(255,255,255,.14); font-size: 12px; color: #5f5f5f; }
</style>
